#Copy this file and save as application.properties
#Do not add your password to this file.
#Add your password (for local use only) where indicated below

spring.application.name=RestApi
spring.mvc.throw-exception-if-no-handler-found=true
spring.web.resources.add-mappings=false

spring.datasource.url=jdbc:mysql://localhost:3306/medical_portal
spring.datasource.username=root
spring.datasource.password=YOUR PASSWORD HERE
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl
spring.jpa.hibernate.ddl-auto=update